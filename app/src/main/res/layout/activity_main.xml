<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== 栏 1：中继工作区 ===== -->
        <ScrollView
            android:id="@+id/scrollWorkspace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="28dp">

            <!-- ===== 骑行记录大按钮（最上面；只影响 FIT 记录，不影响数据转发）===== -->
            <Button
                android:id="@+id/btnRec"
                style="@style/XdsButtonBig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● 开始记录" />

            <TextView
                android:id="@+id/txtRecHint"
                style="@style/XdsValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:text="点按：开始 / 暂停 / 继续　长按：结束记录并导出" />

            <!-- ===== 标题 + 状态 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtClock"
                    style="@style/XdsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipSensor"
                    style="@style/XdsChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="功率计 · 未启动" />

                <TextView
                    android:id="@+id/chipBroadcast"
                    style="@style/XdsChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="广播 · 未启动" />

                <TextView
                    android:id="@+id/chipClients"
                    style="@style/XdsChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="客户端 0" />
            </LinearLayout>

            <!-- ===== 功率 ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/XdsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtParams"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:lineSpacingExtra="5dp"
                        android:text="—" />

                    <com.nz.xdsrelay.BalanceBarView
                        android:id="@+id/balance"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 踏频 / 角度 / 误差 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/XdsCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView style="@style/XdsLabel" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="踏频 RPM" />

                        <TextView
                            android:id="@+id/txtCadence"
                            style="@style/XdsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="--"
                            android:textSize="30sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/XdsCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView style="@style/XdsLabel" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="曲柄角度 °" />

                        <TextView
                            android:id="@+id/txtAngle"
                            style="@style/XdsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="--"
                            android:textSize="30sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/XdsCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView style="@style/XdsLabel" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="错误码" />

                        <TextView
                            android:id="@+id/txtError"
                            style="@style/XdsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="--"
                            android:textSize="30sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ===== 功率曲线 ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/XdsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView style="@style/XdsLabel" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="近 90 秒趋势" />

                        <TextView
                            android:id="@+id/txtPeak"
                            style="@style/XdsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="峰值 -- / 均值 --" />
                    </LinearLayout>

                    <com.nz.xdsrelay.SparklineView
                        android:id="@+id/spark"
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== GPS ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/XdsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView style="@style/XdsLabel" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="GNSS 定位 · 高精度" />

                        <TextView
                            android:id="@+id/txtFix"
                            style="@style/XdsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未定位" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView style="@style/XdsLabel" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="纬度" />
                            <TextView android:id="@+id/txtLat" style="@style/XdsValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="--" />

                            <TextView style="@style/XdsLabel" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                                android:text="海拔 MSL" />
                            <TextView android:id="@+id/txtAltMsl" style="@style/XdsValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="--" />

                            <TextView style="@style/XdsLabel" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                                android:text="大地水准面差距 N" />
                            <TextView android:id="@+id/txtGeoid" style="@style/XdsValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="--" />

                            <TextView style="@style/XdsLabel" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                                android:text="水平精度" />
                            <TextView android:id="@+id/txtAccH" style="@style/XdsValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="--" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView style="@style/XdsLabel" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="经度" />
                            <TextView android:id="@+id/txtLon" style="@style/XdsValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="--" />

                            <TextView style="@style/XdsLabel" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                                android:text="椭球高 H" />
                            <TextView android:id="@+id/txtAltEll" style="@style/XdsValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="--" />

                            <TextView style="@style/XdsLabel" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                                android:text="速度 / 航向" />
                            <TextView android:id="@+id/txtSpeed" style="@style/XdsValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="--" />

                            <TextView style="@style/XdsLabel" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                                android:text="垂直精度" />
                            <TextView android:id="@+id/txtAccV" style="@style/XdsValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:text="--" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/stroke" />

                    <TextView
                        android:id="@+id/txtGpsDetail"
                        style="@style/XdsValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/muted"
                        android:textSize="13sp"
                        android:text="卫星 -- / --    HDOP --    VDOP --    PDOP --" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 转发详情 ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/XdsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/XdsLabel" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="转发 (标准蓝牙)" />

                    <TextView
                        android:id="@+id/txtForward"
                        style="@style/XdsValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:text="未运行" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 记录与上报 ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/XdsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView style="@style/XdsLabel" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="骑行记录 · FIT → nzlab.online" />

                    <TextView
                        android:id="@+id/txtRecord"
                        style="@style/XdsValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:text="未开始记录" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnExportFit"
                            style="@style/XdsButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="导出FIT" />

                        <Button
                            android:id="@+id/btnSite"
                            style="@style/XdsButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="打开网站" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 控制按钮 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnToggle"
                    style="@style/XdsButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="启动中继" />

                <Button
                    android:id="@+id/btnScan"
                    style="@style/XdsButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="重扫" />

                <Button
                    android:id="@+id/btnPick"
                    style="@style/XdsButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="选设备" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSim"
                    style="@style/XdsButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="模拟数据" />

                <Button
                    android:id="@+id/btnKeepAlive"
                    style="@style/XdsButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="后台保活" />

                <Button
                    android:id="@+id/btnClear"
                    style="@style/XdsButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="清空日志" />
            </LinearLayout>

            <!-- ===== 日志 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_log"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView style="@style/XdsLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="运行日志" />

                <TextView
                    android:id="@+id/txtLog"
                    style="@style/XdsValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp"
                    android:text="就绪" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

        <!-- ===== 栏 2：FIT 记录列表与预览 ===== -->
        <ScrollView
            android:id="@+id/scrollFitList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="FIT 骑行数据预览"
                        android:textColor="@color/text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnFitRefresh"
                        style="@style/XdsButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="刷新" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtFitSummary"
                    style="@style/XdsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="共 0 个记录 · 0 B" />

                <!-- 选中的 FIT 详情卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFitDetail"
                    style="@style/XdsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtFitDetailName"
                            style="@style/XdsValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/accent"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:text="未选择记录" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtFitDetailTime"
                                style="@style/XdsLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="时间: --" />

                            <TextView
                                android:id="@+id/txtFitDetailSize"
                                style="@style/XdsLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="大小: --" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtFitDetailDuration"
                                style="@style/XdsLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="时长: --" />

                            <TextView
                                android:id="@+id/txtFitDetailStatus"
                                style="@style/XdsLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/accent"
                                android:text="未上传" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnFitUpload"
                                style="@style/XdsButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="上传到网站" />

                            <Button
                                android:id="@+id/btnFitShare"
                                style="@style/XdsButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="分享/导出" />

                            <Button
                                android:id="@+id/btnFitDelete"
                                style="@style/XdsButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="0.8"
                                android:textColor="@color/err"
                                android:text="删除" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 列表容器 -->
                <TextView
                    style="@style/XdsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="历史记录列表 (点击查看详情/操作)" />

                <LinearLayout
                    android:id="@+id/layoutFitContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- ===== 栏 3：GPX 路线索引与预览 ===== -->
        <ScrollView
            android:id="@+id/scrollGpxList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="GPX 路线索引与预览"
                        android:textColor="@color/text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnGpxRefresh"
                        style="@style/XdsButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="刷新" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnGpxImport"
                        style="@style/XdsButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📥 导入 GPX" />

                    <Button
                        android:id="@+id/btnGpxCreateSample"
                        style="@style/XdsButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1.3"
                        android:text="✨ 示例路书(天大)" />
                </LinearLayout>

                <!-- 选中的 GPX 详情与通过蓝牙发送卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGpxDetail"
                    style="@style/XdsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtGpxDetailName"
                            style="@style/XdsValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/accent"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:text="未选择路书" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtGpxDetailDist"
                                style="@style/XdsValue"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="15sp"
                                android:text="总距离: --" />

                            <TextView
                                android:id="@+id/txtGpxDetailPoints"
                                style="@style/XdsLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="点数: --" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtGpxDetailSize"
                            style="@style/XdsLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="文件: --" />

                        <!-- 核心操作：通过蓝牙发送到码表端 -->
                        <Button
                            android:id="@+id/btnGpxSendBle"
                            style="@style/XdsButtonBig"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="🚀 发送路书到码表端 (BLE)" />

                        <!-- 传输进度展示 -->
                        <LinearLayout
                            android:id="@+id/layoutGpxProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <ProgressBar
                                android:id="@+id/progGpxSend"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="@color/accent" />

                            <TextView
                                android:id="@+id/txtGpxSendStatus"
                                style="@style/XdsLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/accent"
                                android:text="正在传输..." />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnGpxShare"
                                style="@style/XdsButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="分享/导出" />

                            <Button
                                android:id="@+id/btnGpxDelete"
                                style="@style/XdsButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:textColor="@color/err"
                                android:text="删除路书" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 路线索引列表容器 -->
                <TextView
                    style="@style/XdsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="路书列表 (点击选择/发送)" />

                <LinearLayout
                    android:id="@+id/layoutGpxContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ===== 底部导航三栏 ===== -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_bottom_nav"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- 栏 1：中继工作区 -->
        <LinearLayout
            android:id="@+id/tabWorkspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTabWorkspace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中继工作区"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/indTabWorkspace"
                android:layout_width="32dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="4dp"
                android:background="@color/accent" />
        </LinearLayout>

        <!-- 栏 2：FIT 记录 -->
        <LinearLayout
            android:id="@+id/tabFit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTabFit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIT 记录"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <View
                android:id="@+id/indTabFit"
                android:layout_width="32dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="4dp"
                android:background="@color/accent"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- 栏 3：GPX 路线 -->
        <LinearLayout
            android:id="@+id/tabGpx"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTabGpx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPX 路线"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <View
                android:id="@+id/indTabGpx"
                android:layout_width="32dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="4dp"
                android:background="@color/accent"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
